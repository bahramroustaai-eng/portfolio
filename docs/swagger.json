    "definitions": {
        "debt.Debt": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "integer"
                },
                "borrower_id": {
                    "type": "integer"
                },
                "borrower_username": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "lender_id": {
                    "type": "integer"
                },
                "lender_username": {
                    "type": "string"
                }
            }
        },
        "transport.CreateDebtRequest": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "integer"
                },
                "borrower": {
                    "type": "string"
                }
            }
        },
        "transport.CreateDebtResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                }
            }
        },
        "transport.CreateUserRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "transport.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
